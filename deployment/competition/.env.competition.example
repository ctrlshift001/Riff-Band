# Copy this file to .env.competition only for a private competition package.
# Never commit the real file or add it to a reusable Docker image.

AI4MS_MODEL=deepseek-v4-pro
AI4MS_FALLBACK_MODELS=deepseek-v4-flash
AI4MS_INFERENCE_TIMEOUT_SECONDS=90
AI4MS_INFERENCE_MAX_ATTEMPTS=2
AI4MS_INFERENCE_MAX_TOKENS=4000

AUTOENV_OPENAI_API_KEY=replace-with-a-competition-only-key
AUTOENV_OPENAI_BASE_URL=https://api.deepseek.com
AUTOENV_OPENAI_MODELS=deepseek-v4-pro,deepseek-v4-flash
AUTOENV_OPENAI_TEMPERATURE=1
AUTOENV_OPENAI_TOP_P=1

AI4MS_AO_MAX_ATTEMPTS=2
AI4MS_AO_MAX_SUBAGENT_STEPS=7
AI4MS_AO_MAX_PARALLEL=3
AI4MS_AO_TIMEOUT_SECONDS=150

# Required for the private competition package and checked at startup.
SERPER_API_KEY=replace-with-a-competition-only-serper-key
SERPER_BASE_URL=https://google.serper.dev/search
AI4MS_SEARCH_MAX_CITATIONS=8
AI4MS_SEARCH_READ_TOP_K=4
AI4MS_WEB_READ_TIMEOUT_SECONDS=18

# Optional, free read-only official statistics connector:
# https://apikeys.datacommons.org
AI4MS_DATACOMMONS_API_KEY=
AI4MS_DATACOMMONS_MCP_URL=https://api.datacommons.org/mcp
AI4MS_MCP_TIMEOUT_SECONDS=45

AI4MS_STATA_RUNNER_URL=http://host.docker.internal:8765
AI4MS_STATA_RUNNER_TOKEN=
